---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Hypnagogia — Jinzi Niu">
  <div class="max-w-5xl mx-auto px-6 pt-32 pb-24">

    <!-- Back -->
    <a href="/" class="text-sm text-neutral-500 hover:text-white transition-colors mb-12 inline-block">
      ← Back to Game Projects
    </a>

    <!-- Header -->
    <div class="mb-16">
      <h1 class="text-5xl md:text-6xl font-light text-white mb-6">Hypnagogia</h1>
    </div>

    <!-- Cover -->
    <div class="mb-16 rounded-2xl overflow-hidden w-full">
      <img src="/images/hypnagogia-cover.jpg" alt="Hypnagogia" class="w-full object-cover" />
    </div>

    <!-- Game Loop -->
    <div class="mt-24">
      <div class="border-t border-neutral-800 pt-12 mb-10">
        <h2 class="text-xs uppercase tracking-widest text-neutral-500">Game Loop</h2>
      </div>
      <div class="bg-white rounded-2xl p-4 md:p-8">
        <img src="/images/hypnagogia/gameloop.png" alt="Hypnagogia game loop diagram" class="w-full object-contain" />
      </div>
    </div>

  </div>
</Layout>
