---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Jean (Jinzi) Niu — CV</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; font-size: 11px; color: #111; background: white; line-height: 1.45; }
    .page { width: 210mm; min-height: 297mm; padding: 12mm 14mm; }

    /* Header */
    .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1.5px solid #111; padding-bottom: 8px; margin-bottom: 12px; gap: 12px; }
    .header-left { display: flex; align-items: center; gap: 12px; }
    .header-photo { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; object-position: center 15%; flex-shrink: 0; }
    .header h1 { font-size: 22px; font-weight: 300; letter-spacing: -0.3px; }
    .header p { font-size: 10px; color: #555; margin-top: 3px; }
    .header-right { text-align: right; font-size: 9.5px; color: #444; line-height: 1.7; }
    .header-right a { color: #1a0dab; text-decoration: none; }

    /* Layout */
    .columns { display: grid; grid-template-columns: 175px 1fr; gap: 16px; }

    /* Section titles */
    h2 { font-size: 8px; font-weight: 600; letter-spacing: 1.2px; text-transform: uppercase; color: #888; border-bottom: 0.5px solid #ddd; padding-bottom: 3px; margin-bottom: 8px; }

    /* Left column */
    .left-section { margin-bottom: 14px; }
    .skill-cat { font-size: 8px; color: #888; margin-bottom: 1px; }
    .skill-val { font-size: 9.5px; color: #222; margin-bottom: 6px; }

    /* Education */
    .edu-item { margin-bottom: 8px; }
    .edu-degree { font-size: 9.5px; font-weight: 500; }
    .edu-school { font-size: 9px; color: #555; }
    .edu-period { font-size: 8px; color: #888; }

    /* Experience */
    .exp-item { margin-bottom: 8px; }
    .exp-header { display: flex; justify-content: space-between; align-items: baseline; }
    .exp-role { font-size: 9.5px; font-weight: 500; }
    .exp-period { font-size: 8px; color: #888; white-space: nowrap; margin-left: 6px; }
    .exp-company { font-size: 8.5px; color: #666; margin-bottom: 2px; }
    .exp-bullets { padding-left: 0; list-style: none; }
    .exp-bullets li { font-size: 8.5px; color: #444; padding-left: 9px; position: relative; margin-bottom: 1.5px; }
    .exp-bullets li::before { content: "–"; position: absolute; left: 0; color: #aaa; }
  </style>
</head>
<body>
<div class="page">

  <!-- Header -->
  <div class="header">
    <div class="header-left">
      <img src="http://localhost:4321/images/profile.png" alt="Jean Jinzi Niu" class="header-photo" />
      <div>
        <h1>Jean (Jinzi) Niu</h1>
        <p>Game Design Student · Technical Artist · Berlin</p>
      </div>
    </div>
    <div class="header-right">
      <div>jinziniu1310@gmail.com</div>
      <div><a href="https://www.linkedin.com/in/jinzi-niu-b94148280">linkedin.com/in/jinzi-niu-b94148280</a></div>
      <div><a href="https://jinziniu.space">jinziniu.space</a></div>
    </div>
  </div>

  <div class="columns">
    <!-- Left: Skills + Education -->
    <div>
      <div class="left-section">
        <h2>Skills</h2>
        {skills.map(s => (
          <div>
            <div class="skill-cat">{s.category}</div>
            <div class="skill-val">{s.items}</div>
          </div>
        ))}
      </div>

      <div class="left-section">
        <h2>Education</h2>
        {education.map(e => (
          <div class="edu-item">
            <div class="edu-degree">{e.degree}</div>
            <div class="edu-school">{e.school}</div>
            <div class="edu-period">{e.period}</div>
            {e.note && <div style="font-size:7.5px;color:#666;margin-top:1px;">{e.note}</div>}
          </div>
        ))}
      </div>
    </div>

    <!-- Right: Experience -->
    <div>
      <h2>Experience</h2>
      {experience.map(job => (
        <div class="exp-item">
          <div class="exp-header">
            <span class="exp-role">{job.role}</span>
            <span class="exp-period">{job.period}</span>
          </div>
          <div class="exp-company">{job.company}</div>
          {job.bullets.length > 0 && (
            <ul class="exp-bullets">
              {job.bullets.map(b => <li>{b}</li>)}
            </ul>
          )}
        </div>
      ))}
    </div>
  </div>

</div>
</body>
</html>
